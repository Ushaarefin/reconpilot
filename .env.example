# Braintree sandbox keys: sandbox.braintreegateway.com > Settings (gear) > API > API Keys
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=
# Optional: currency of your sandbox merchant account (auto-detected if blank)
BT_CURRENCY=

# AI: set ONE of these (without either, a rule-based fallback is used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-sonnet-5-5 or gpt-4o-mini
AI_MODEL=
